---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await recipe.render();
const data = recipe.data;

const allRecipes = await getCollection('recipes');
const more = allRecipes.filter((r) => r.slug !== recipe.slug).slice(0, 3);
---
<BaseLayout title={`${data.title} — Courtney Price`}>
  <div class="wrap">
    <Nav />

    <div class="crumb">
      <a href="/">Home</a><span>/</span><a href="/recipes">Recipes</a><span>/</span>{data.title}
    </div>

    <section class="recipe-hero">
      <div>
        <div class="recipe-tags">
          {data.categories.map((c: string) => <span class="tag">{c}</span>)}
        </div>
        <h1 set:html={data.title.replace(/(High-Protein|Refreshing)/, '<em>$1</em>')} />
        <p class="recipe-intro">{data.intro}</p>
        <div class="meta-row">
          <div class="meta-item"><strong>{data.prepTime}</strong><span>Prep time</span></div>
          <div class="meta-item"><strong>{data.cookTime}</strong><span>Cook time</span></div>
          <div class="meta-item"><strong>{data.servings}</strong><span>Servings</span></div>
          <div class="meta-item"><strong>{data.diets.join(' · ')}</strong><span>Dietary fit</span></div>
        </div>
      </div>
      <div class="recipe-photo">
        <div class="blob"><img src={data.image} alt={data.title} /></div>
        {data.diets.length > 0 && (
          <div class="stamps-float">
            {data.diets.map((d: string) => <div class="stamp">{d}</div>)}
          </div>
        )}
      </div>
    </section>

    <section class="why-band">
      <div class="why-head">
        <div class="eyebrow">Why this recipe works</div>
        <h2>A nutritionist's take</h2>
      </div>
      <div class="icon-row">
        <div class="icon-item"><span class="num">{data.nutrition.protein}</span><span class="label">Protein</span></div>
        <div class="icon-item"><span class="num">{data.nutrition.fiber}</span><span class="label">Fiber</span></div>
        <div class="icon-item"><span class="num">{data.nutrition.glycemicLoad}</span><span class="label">Glycemic load</span></div>
        <div class="icon-item"><span class="num">{data.nutrition.calories}</span><span class="label">Calories / serving</span></div>
      </div>
      <p class="why-note">{data.nutritionNote}</p>
    </section>

    <section class="recipe-body">
      <div class="ingredients">
        <div class="servings-row">
          <h3>Ingredients</h3>
          <div class="servings-control">{data.servings} servings</div>
        </div>
        <ul class="ing-list">
          {data.ingredients.map((ing: { amount: string; item: string }) => (
            <li><span>{ing.amount}</span><span>{ing.item}</span></li>
          ))}
        </ul>
      </div>

      <div class="steps">
        <h3>Instructions</h3>
        <ol class="steps-list">
          {data.steps.map((step: { title: string; description: string }) => (
            <li>
              <div>
                <h4>{step.title}</h4>
                <p>{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {data.note && (
      <div class="notes">
        <h4>Courtney's note</h4>
        <p>{data.note}</p>
      </div>
    )}

    {more.length > 0 && (
      <section class="more-recipes">
        <h3>You might also like</h3>
        <div class="more-grid">
          {more.map((r) => (
            <a href={`/recipes/${r.slug}`} class="more-card">
              <div class="more-card-img"><img src={r.data.image} alt={r.data.title} /></div>
              <div class="more-cat">{r.data.categories[0]}</div>
              <h4>{r.data.title}</h4>
            </a>
          ))}
        </div>
      </section>
    )}

    <Footer />
  </div>
</BaseLayout>

<style>
  .crumb{font-size:12px; color:var(--ink-soft); padding:6px 0 30px;}
  .crumb a:hover{color:var(--maroon);}
  .crumb span{margin:0 8px; opacity:0.5;}

  .recipe-hero{display:grid; grid-template-columns:1fr 0.95fr; gap:64px; align-items:center; padding-bottom:70px;}
  .recipe-tags{display:flex; gap:10px; margin-bottom:20px;}
  .tag{font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--maroon); border:1px solid var(--maroon); border-radius:100px; padding:5px 14px;}
  .recipe-hero h1{font-size:46px; line-height:1.12; margin-bottom:20px; font-weight:400;}
  .recipe-intro{color:var(--ink-soft); font-size:16px; max-width:460px; margin-bottom:32px;}
  .meta-row{display:flex; gap:36px; flex-wrap:wrap; border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:22px 0;}
  .meta-item{display:flex; flex-direction:column; gap:4px;}
  .meta-item strong{font-family:'Cormorant Garamond', serif; font-style:italic; font-size:22px; color:var(--maroon); font-weight:500;}
  .meta-item span{font-size:11px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.06em;}
  .recipe-photo{position:relative;}
  .recipe-photo .blob{aspect-ratio:4/5; overflow:hidden; border-radius:50% 50% 46% 54% / 55% 45% 55% 45%;}
  .recipe-photo img{width:100%; height:100%; object-fit:cover;}
  .stamps-float{position:absolute; top:26px; left:26px; display:flex; gap:8px;}
  .stamp{width:34px; height:34px; border-radius:50%; background:rgba(255,255,255,0.85); border:1px solid var(--maroon); display:flex; align-items:center; justify-content:center; font-size:9px; font-family:'Cormorant Garamond', serif; font-style:italic; font-weight:600; color:var(--maroon); box-shadow:0 2px 8px rgba(59,46,39,0.15);}

  .why-band{padding:56px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); margin-bottom:70px;}
  .why-head{display:flex; align-items:baseline; gap:16px; margin-bottom:28px;}
  .why-head .eyebrow{font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:var(--maroon);}
  .why-head h2{font-size:24px; font-weight:400;}
  .icon-row{display:flex; gap:44px; flex-wrap:wrap;}
  .icon-item{border-left:1px solid var(--maroon); padding-left:16px;}
  .icon-item .num{font-family:'Cormorant Garamond', serif; font-style:italic; font-size:26px; color:var(--maroon); font-weight:500; display:block; line-height:1;}
  .icon-item .label{font-size:11px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.05em;}
  .why-note{color:var(--ink-soft); font-size:14px; max-width:640px; margin-top:22px;}

  .recipe-body{display:grid; grid-template-columns:0.9fr 1.6fr; gap:70px; padding-bottom:90px;}
  .ingredients h3, .steps h3{font-size:24px; font-weight:400; margin-bottom:26px;}
  .servings-row{display:flex; align-items:center; justify-content:space-between; margin-bottom:26px;}
  .servings-control{font-size:13px; color:var(--ink-soft);}
  .ing-list{list-style:none;}
  .ing-list li{display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid var(--line); font-size:15px;}
  .ing-list li span:first-child{color:var(--ink-soft); font-size:13px;}
  .steps-list{list-style:none; counter-reset:step;}
  .steps-list li{counter-increment:step; display:grid; grid-template-columns:44px 1fr; gap:20px; padding-bottom:34px; margin-bottom:34px; border-bottom:1px solid var(--line);}
  .steps-list li:last-child{border-bottom:none;}
  .steps-list li::before{
    content:counter(step); font-family:'Cormorant Garamond', serif; font-style:italic; font-size:26px; color:var(--maroon);
    width:44px; height:44px; border:1px solid var(--maroon); border-radius:50%; display:flex; align-items:center; justify-content:center;
  }
  .steps-list h4{font-size:16px; font-weight:500; margin-bottom:6px; font-family:'Jost';}
  .steps-list p{color:var(--ink-soft); font-size:14.5px;}

  .notes{background:var(--bg-soft); border-radius:20px; padding:36px 40px; margin-bottom:90px;}
  .notes h4{font-size:18px; font-style:italic; font-weight:500; margin-bottom:10px; font-family:'Cormorant Garamond', serif; color:var(--maroon);}
  .notes p{color:var(--ink-soft); font-size:14.5px; max-width:640px;}

  .more-recipes{padding-bottom:100px;}
  .more-recipes h3{font-size:24px; font-weight:400; margin-bottom:36px;}
  .more-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:30px;}
  .more-card{display:block;}
  .more-card-img{aspect-ratio:1/1; border-radius:14px; overflow:hidden; margin-bottom:16px;}
  .more-card-img img{width:100%; height:100%; object-fit:cover;}
  .more-cat{font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--gold); margin-bottom:4px;}
  .more-card h4{font-size:16px; font-weight:500;}

  @media (max-width: 860px){
    .recipe-hero, .recipe-body{grid-template-columns:1fr;}
    .recipe-hero h1{font-size:34px;}
    .more-grid{grid-template-columns:1fr;}
  }
</style>
