---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root{
    --bg: #FDF8F3;
    --bg-soft: #F6EDE2;
    --tan: #E8DAC0;
    --tan-stripe: #F3E9DA;
    --ink: #3B2E27;
    --ink-soft: #948575;
    --maroon: #6E2A30;
    --maroon-deep: #551F24;
    --gold: #A9814B;
    --line: #EDE1D0;
    --card: #FFFFFF;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{background:var(--bg); color:var(--ink); font-family:'Jost', sans-serif; font-weight:300; line-height:1.65; -webkit-font-smoothing:antialiased;}
  h1,h2,h3,h4{font-family:'Cormorant Garamond', serif; font-weight:500; letter-spacing:0.01em; color:var(--ink);}
  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block; filter:saturate(0.82) sepia(0.06) brightness(1.03) contrast(0.96);}
  .illustration img{filter:none;}
  .wrap{max-width:1160px; margin:0 auto; padding:0 40px;}
  em{font-style:italic; color:var(--maroon);}

  .blob{ border-radius: 50% 50% 46% 54% / 55% 45% 55% 45%; overflow:hidden; }
  .blob-1{ border-radius: 42% 58% 63% 37% / 47% 40% 60% 53%; overflow:hidden; }
  .blob-2{ border-radius: 60% 40% 39% 61% / 53% 60% 40% 47%; overflow:hidden; }
  .blob-3{ border-radius: 38% 62% 55% 45% / 60% 48% 52% 40%; overflow:hidden; }
  .blob-4{ border-radius: 55% 45% 48% 52% / 40% 55% 45% 60%; overflow:hidden; }

  .grain{ position:relative; }
  .grain::after{
    content:''; position:absolute; inset:0; pointer-events:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/></svg>");
    mix-blend-mode:overlay; opacity:0.35; background-size:160px 160px;
  }

  .btn{display:inline-flex; align-items:center; gap:8px; background:var(--maroon); color:#fff; padding:14px 30px; border-radius:100px; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; font-weight:400; transition:background .25s, transform .2s, box-shadow .25s; border:none; cursor:pointer;}
  .btn:hover{background:var(--maroon-deep); transform:translateY(-2px) scale(1.02); box-shadow:0 10px 24px -10px rgba(110,42,48,0.5);}
  .btn-outline{background:transparent; border:1px solid var(--ink); color:var(--ink);}
  .btn-outline:hover{border-color:var(--maroon); color:var(--maroon); background:transparent;}

  @media (max-width: 860px){
    .navlinks{display:none;}
  }
</style>
